{
  "manifest_version": 3,
  "name": "Wiro: AI Tools for Images, Video, Audio, Text",
  "short_name": "Wiro",
  "version": "0.1.0",
  "description": "Right-click an image, video, audio clip or selected text to run Wiro AI models and tools: animate, edit, upscale, voice and more.",
  "homepage_url": "https://wiro.ai",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wiro",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Wiro",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "permissions": ["menus", "storage", "identity"],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@wiro.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
