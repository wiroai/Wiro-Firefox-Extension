{
  "name": "wiro-firefox-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Wiro AI for Firefox: right-click any image, video, audio clip or text to run Wiro AI models and tools.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npx --yes web-ext@10.8.0 lint --source-dir dist",
    "package": "npx --yes web-ext@10.8.0 build --source-dir dist --overwrite-dest"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
